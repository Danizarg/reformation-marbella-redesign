# Public site URL, used for canonical tags, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://reformation-marbella-redesign.vercel.app

# Optional. When set, the quote/contact form delivers by email through Resend.
# When unset, the form stays fully usable: it validates, then hands the visitor a
# pre-filled email (and a WhatsApp option) so no enquiry is ever lost.
RESEND_API_KEY=
QUOTE_INBOX=reformationmarbella@gmail.com
QUOTE_FROM="Reformation Marbella <onboarding@resend.dev>"
